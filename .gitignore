# ---- Secrets: never commit ----
.env
.env.*
!.env.example
*.pem
*.key
secrets.toml

# ---- Disbox runtime artifacts ----
# Vaults hold encrypted keys and metadata. Never commit one.
*.dbx
*.dbx-wal
*.dbx-shm
snapshots/
vaults/

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ---- Environments ----
.venv/
venv/
ENV/

# ---- Tooling caches ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/
.nox/
.tox/

# ---- Packaging ----
*.spec.bak
packaging/output/

# ---- Legacy JS client (removed in v2; retained in git history) ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- IDE / OS ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---- Logs ----
*.log
logs/

# CI audit artifact
requirements-audit.txt
