# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Without these, Disbox stores blobs on the local disk instead of Discord.
# Everything else works unchanged.

# Bot token from https://discord.com/developers/applications
DISBOX_BOT_TOKEN=

# The channel the bot posts attachments to. A channel ID, not a server ID:
# enable Developer Mode in Discord, then right-click the channel and copy it.
DISBOX_CHANNEL_ID=
