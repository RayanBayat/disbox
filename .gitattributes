# Normalize line endings so Windows and Linux CI produce identical diffs.
* text=auto eol=lf

# Windows-native scripts must keep CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary — never touch.
*.png  binary
*.ico  binary
*.jpg  binary
*.gz   binary
*.zip  binary
*.dbx  binary

# Generated: collapse in diffs and exclude from language stats.
uv.lock         linguist-generated=true -diff
package-lock.json linguist-generated=true -diff
